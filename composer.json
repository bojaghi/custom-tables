{
  "name": "bojaghi/custom-tables",
  "description": "커스텀 테이블을 위한 보자기 유틸리티.",
  "homepage": "https://github.com/bojaghi/custom-tables",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "Bojaghi\\CustomTables\\": "inc/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bojaghi\\CustomTables\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "changwoo",
      "email": "ep6tri@hotmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "bojaghi/contract": "^2",
    "bojaghi/helper": "^2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "bojaghi/dictionary": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^4.0",
    "alleyinteractive/composer-wordpress-autoloader": "^1.3"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "version": "2.0.0",
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-autoloader": {
      "autoload": {
        "Bojaghi\\CustomTables\\": "inc/"
      },
      "autoload-dev": {
        "Bojaghi\\CustomTables\\Tests": "tests/"
      },
      "inject": true
    }
  }
}
